# HomeKeep environment variables. The contract is docs/infra-contract.md §9.
#
# Copy to .env only for local overrides: `make run` loads .env into the app. Every value below is
# empty on purpose, and an empty value counts as unset, so a copied file changes nothing until you
# fill a line in. The comment above each line shows the expected shape.
#
# Keep real AWS values (for `make eval`, Deb only) in .env.eval, never in .env, so they cannot
# leak into `make run`. Both files are gitignored. This repository is public: placeholders only.

# --- Every environment -------------------------------------------------------
# local | test | demo
ENV=local
# DEBUG | INFO | WARNING | ERROR (default INFO)
LOG_LEVEL=
# default 8000
PORT=
# default us-east-1
AWS_REGION=

# --- Local only (ENV=local): DynamoDB Local; forbidden in test and demo -------
# make run sets this itself; this value is for running uvicorn on the host
DYNAMODB_ENDPOINT_URL=http://localhost:8001

# --- Required in test and demo (local has defaults or does not need them) ----
# homekeep-<ENV> (local default homekeep-local)
TABLE_NAME=
# <BUCKET_NAME>
BUCKET_NAME=
# <COGNITO_USER_POOL_ID>
COGNITO_USER_POOL_ID=
# https://<DOMAIN_PREFIX>.auth.us-east-1.amazoncognito.com
COGNITO_DOMAIN=
# <COGNITO_WEB_CLIENT_ID>
COGNITO_WEB_CLIENT_ID=
# <COGNITO_MCP_CLIENT_ID>
COGNITO_MCP_CLIENT_ID=
# https://<APP_DOMAIN> (origin only; local default http://localhost:8000)
APP_BASE_URL=
# comma-separated origins (local default: APP_BASE_URL)
ALLOWED_ORIGINS=

# --- Model ---------------------------------------------------------------------
# default us.anthropic.claude-haiku-4-5-20251001-v1:0
MODEL_ID=
# default: AWS_REGION
BEDROCK_REGION=
# bedrock | fake (fake only when ENV is local or test; local default fake)
MODEL_PROVIDER=

# --- Behaviour and caps ------------------------------------------------------
# default http://127.0.0.1:<PORT>/mcp
MCP_LOOPBACK_URL=
# true | false (default false)
FAULTS_ENABLED=
# Test only (ENV=test); the app refuses to start if set elsewhere. ISO-8601 with an offset.
CLOCK_OVERRIDE=
# default 300
DAILY_TURN_CAP=
# default 12
MAX_TOOL_CYCLES=
# default 20
TURN_BUDGET_SECONDS=

# --- Optional: Ops page cost estimate (USD per million tokens) ----------------
BEDROCK_PRICE_INPUT_PER_MTOK_USD=
BEDROCK_PRICE_OUTPUT_PER_MTOK_USD=
